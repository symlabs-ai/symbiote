# Configuração do demo. Copiado para demo/demo.env (fora do git, modo 0600).
# Sem chave aqui, a página pede provider e chave na abertura e grava neste arquivo.

# anthropic, openai ou symgateway
DEMO_PROVIDER=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Modelo principal (conversa) e auxiliar (reflexão, evolução, tags semânticas,
# dream, review de skills). Vazio = padrão do provider. Com symgateway o
# principal é obrigatório (um dos IDs de GET /v1/models) e o auxiliar, se
# vazio, repete o principal.
DEMO_MODEL=
DEMO_AUX_MODEL=

DEMO_PORT=8010

# SymGateway. Com DEMO_PROVIDER=symgateway a chave do gateway substitui a do
# provider (precisa de models.read, work_sessions.create e gateway.llm.invoke)
# e cada sessão do Symbiote abre uma sessão de trabalho no gateway.
# SYMGATEWAY_BASE_URL vazio = https://symgateway.symlabs.ai.
# SYMGATEWAY_PROJECT_SLUG só se a chave for de um projeto (X-Project-Slug).
# Chave + SYMGATEWAY_BASE_URL preenchidos também habilitam a tool web_search,
# com qualquer provider. Ela chama o serviço "websearch" do Objective web_seek
# do gateway (POST /v1/objectives/invoke); a chave precisa de objectives.use e
# external_services.invoke. DEMO_SEARCH_OBJECTIVE troca o Objective; "none"
# usa o proxy Brave direto (/proxy/brave/web-search).
SYMGATEWAY_API_KEY=
SYMGATEWAY_BASE_URL=
SYMGATEWAY_PROJECT_SLUG=
# DEMO_SEARCH_OBJECTIVE=web_seek
